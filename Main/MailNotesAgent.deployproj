<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Condition="Exists('$(BDS)\bin\CodeGear.Deployment.targets')" Project="$(BDS)\bin\CodeGear.Deployment.targets"/>
    <ProjectExtensions>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <PropertyGroup>
        <DeviceId Condition="'$(Platform)'=='Android'"/>
        <DeviceId Condition="'$(Platform)'=='Android64'"/>
        <DeviceId Condition="'$(Platform)'=='iOSDevice64'"/>
        <DeviceId Condition="'$(Platform)'=='iOSSimARM64'"/>
    </PropertyGroup>
    <ItemGroup Condition="'$(Platform)'=='WinARM64EC'"/>
    <ItemGroup Condition="'$(Platform)'=='OSX64'"/>
    <ItemGroup Condition="'$(Platform)'=='Win32'"/>
    <ItemGroup Condition="'$(Platform)'=='Android64'"/>
    <ItemGroup Condition="'$(Platform)'=='Android'"/>
    <ItemGroup Condition="'$(Platform)'=='OSXARM64'">
        <DeployFile Include="..\Resources\MacOS\MN-WARN-SW.icns" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>MN-WARN-SW.icns</RemoteName>
            <DeployClass>File</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Release\MailNotesAgent" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\Contents\MacOS\</RemoteDir>
            <RemoteName>MailNotesAgent</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="OSXARM64\Release\MailNotesAgent.info.plist" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\Contents\</RemoteDir>
            <RemoteName>Info.plist</RemoteName>
            <DeployClass>ProjectOSXInfoPList</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Debug\MailNotes.entitlements" Condition="'$(Config)'=='Debug'">
            <RemoteDir>MailNotesAgent.app\..\</RemoteDir>
            <RemoteName>MailNotes.entitlements</RemoteName>
            <DeployClass>ProjectOSXEntitlements</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Debug\MailNotes.info.plist" Condition="'$(Config)'=='Debug'">
            <RemoteDir>MailNotesAgent.app\Contents\</RemoteDir>
            <RemoteName>Info.plist</RemoteName>
            <DeployClass>ProjectOSXInfoPList</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="..\Resources\MacOS\MN-OK-SW.icns" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>MN-OK-SW.icns</RemoteName>
            <DeployClass>File</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="..\Resources\MacOS\MN-ERR-SW.icns" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>MN-ERR-SW.icns</RemoteName>
            <DeployClass>File</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Release\MailNotesAgent.entitlements" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\..\</RemoteDir>
            <RemoteName>MailNotesAgent.entitlements</RemoteName>
            <DeployClass>ProjectOSXEntitlements</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="$(BDS)\Redist\osx64\libcgsqlite3.dylib" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\Contents\MacOS\</RemoteDir>
            <RemoteName>libcgsqlite3.dylib</RemoteName>
            <DeployClass>File</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="..\Data\MailNotes.sqlite" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent.app\Contents\MacOS\Data\</RemoteDir>
            <RemoteName>MailNotes.sqlite</RemoteName>
            <DeployClass>File</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Debug\MailNotesAgent" Condition="'$(Config)'=='Debug'">
            <RemoteDir>MailNotesAgent.app\Contents\MacOS\</RemoteDir>
            <RemoteName>MailNotesAgent</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='Win64'">
        <DeployFile Include="..\Resources\Windows\MN-OK-ALL.ico" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent\</RemoteDir>
            <RemoteName>MN-OK-ALL.ico</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Win64\Release\MailNotesAgent.exe" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent\</RemoteDir>
            <RemoteName>MailNotesAgent.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="Win64\Debug\MailNotesAgent.exe" Condition="'$(Config)'=='Debug'">
            <RemoteDir>MailNotesAgent\</RemoteDir>
            <RemoteName>MailNotesAgent.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="..\Resources\MN-OK.png" Condition="'$(Config)'=='Release'">
            <RemoteDir>MailNotesAgent\Assets\</RemoteDir>
            <RemoteName>Logo44x44.png</RemoteName>
            <DeployClass>UWP_DelphiLogo44</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='iOSDevice64'"/>
    <ItemGroup Condition="'$(Platform)'=='iOSSimARM64'"/>
    <ItemGroup Condition="'$(Platform)'=='Win64x'"/>
</Project>
