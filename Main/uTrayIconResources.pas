function CreateIconFromBytes(const Data; const DataSize: Cardinal): HICON;
begin
  Result := CreateIconFromResourceEx(
    @Data,
    DataSize,
    True,
    $00030000,
    16,
    16,
    LR_DEFAULTCOLOR
  );
end;

function CreateMailNotesIcon(const ResourceIndex: Integer): HICON;
begin
  case ResourceIndex of
    0: Result := CreateIconFromBytes(MN_OK_COLOR, SizeOf(MN_OK_COLOR));
    1: Result := CreateIconFromBytes(MN_WARN_COLOR, SizeOf(MN_WARN_COLOR));
    2: Result := CreateIconFromBytes(MN_ERR_COLOR, SizeOf(MN_ERR_COLOR));
    3: Result := CreateIconFromBytes(MN_OK_SW, SizeOf(MN_OK_SW));
    4: Result := CreateIconFromBytes(MN_WARN_SW, SizeOf(MN_WARN_SW));
    5: Result := CreateIconFromBytes(MN_ERR_SW, SizeOf(MN_ERR_SW));
    6: Result := CreateIconFromBytes(MN_UPDATE_COLOR, SizeOf(MN_UPDATE_COLOR));
  else
    Result := 0;
  end;
end;

